---
import '../styles/tokens.css';
import '../styles/componentes.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
