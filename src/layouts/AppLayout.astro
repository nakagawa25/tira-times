---
import '../styles/tokens.css';
import '../styles/componentes.css';
import '../styles/ads.css';
import '../styles/sheet.css';

interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1b7a3e" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // @vite-pwa/astro doesn't inject the manifest link or SW registration into
      // Astro's static HTML output (unlike the Vite SPA flavor of the plugin), so
      // both are wired up here instead — see astro.config.mjs for the PWA config.
      if ('serviceWorker' in navigator) {
        import('virtual:pwa-register').then(({ registerSW }) => {
          registerSW({ immediate: true });
        });
      }
    </script>
  </body>
</html>
